{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The only capability: the main window may listen to app events and call DiZero's own commands. No filesystem, shell, dialog or opener access is granted to the webview; those run in Rust behind validated commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-ready",
    "allow-app-info",
    "allow-settings-get",
    "allow-settings-update",
    "allow-settings-reset",
    "allow-settings-export",
    "allow-settings-import",
    "allow-workspace-snapshot",
    "allow-messages-list",
    "allow-message-send",
    "allow-message-delete",
    "allow-conversation-mark-read",
    "allow-members-list",
    "allow-messages-search",
    "allow-plugins-overview",
    "allow-plugin-contributions",
    "allow-plugin-install-bundled",
    "allow-plugin-install-folder",
    "allow-plugin-approve",
    "allow-plugin-disable",
    "allow-plugin-set-permission",
    "allow-plugin-uninstall",
    "allow-plugin-rollback",
    "allow-plugin-reset",
    "allow-plugin-run-command",
    "allow-plugin-render-panel",
    "allow-plugin-panel-action",
    "allow-plugin-validate-folder",
    "allow-perf-snapshot",
    "allow-logs-recent",
    "allow-logs-open-folder",
    "allow-open-link",
    "allow-data-stats",
    "allow-data-reset-demo",
    "allow-data-vacuum",
    "allow-data-prune",
    "allow-data-backup",
    "allow-data-clear-plugin-storage"
  ]
}
